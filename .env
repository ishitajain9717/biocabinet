# Local environment config for the RNA-seq pipeline.
# Loaded automatically at startup — no need to export variables manually.

# LLM for RAG chat and pipeline summarisation (needs: ollama pull llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b

# Uncomment and set if you want to use OpenAI instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
