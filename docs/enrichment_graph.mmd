---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	collect_config(collect_config)
	load_data(load_data)
	train(train)
	eval(eval)
	infer(infer)
	summarize(summarize)
	error_node(error_node)
	__end__([<p>__end__</p>]):::last
	__start__ --> collect_config;
	collect_config --> load_data;
	eval -.-> error_node;
	eval -.-> infer;
	infer -.-> error_node;
	infer -.-> summarize;
	load_data -.-> error_node;
	load_data -.-> train;
	train -.-> error_node;
	train -.-> eval;
	error_node --> __end__;
	summarize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
